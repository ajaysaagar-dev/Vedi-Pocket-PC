{
  "expo": {
    "name": "mobile-new",
    "slug": "mobile-new",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../logo.jpeg",
    "scheme": "mobilenew",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true,
          "NSExceptionDomains": {
            "local": {
              "NSExceptionAllowsInsecureHTTPLoads": true,
              "NSIncludesSubdomains": true
            }
          }
        }
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#0F131A",
        "foregroundImage": "../logo.jpeg",
        "backgroundImage": "../logo.jpeg",
        "monochromeImage": "../logo.jpeg"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "../logo.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow PC Remote to access the camera to scan pairing QR codes."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "../logo.jpeg",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F131A",
          "dark": {
            "backgroundColor": "#0F131A"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "manifest": {
              "usesFeature": [
                { "name": "android.hardware.camera", "required": false },
                { "name": "android.hardware.camera.autofocus", "required": false }
              ]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
