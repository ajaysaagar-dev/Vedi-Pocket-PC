{
  "name": "vedi-pocketpc-desktop",
  "version": "1.0.0",
  "description": "Vedi Pocket PC Desktop Controller",
  "main": "controller/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "electron",
    "pocketpc",
    "screen-stream",
    "remote-control",
    "expo"
  ],
  "author": "Vedi Pocket PC Team",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.vedipocketpc.desktop",
    "productName": "Vedi Pocket PC",
    "copyright": "Copyright © 2026 Vedi Pocket PC",
    "icon": "assets/icon.ico",
    "asar": false,
    "win": {
      "icon": "assets/icon.ico",
      "target": ["nsis", "zip"],
      "requestedExecutionLevel": "asInvoker",
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "controller/**/*",
      "assets/**/*",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "extraResources": [
      {
        "from": "screen-stream-server",
        "to": "screen-stream-server",
        "filter": ["**/*"]
      },
      {
        "from": "veddi-pocketpc",
        "to": "veddi-pocketpc",
        "filter": ["**/*", "!node_modules/.cache/**", "!.git/**"]
      },
      {
        "from": "vedi-pocketpc-backend",
        "to": "vedi-pocketpc-backend",
        "filter": ["**/*"]
      }
    ]
  }
}
